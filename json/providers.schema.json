{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Providers",
  "description": "Schema for LLM provider definitions",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string" },
      "npm": { "type": "string" },
      "uri": { "type": "string", "format": "uri" }
    },
    "additionalProperties": false
  }
}
