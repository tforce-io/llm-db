{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "plan",
  "agent": {
    "build": {
      "color": "primary"
    },
    "plan": {
      "color": "secondary"
    }
  },
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "http://ollamago.tforce.xyz/mcp",
      "enabled": true,
      "headers": {
        "x-bf-vk": "sk-bf-00000000"
      }
    }
  },
  "provider": {
    "github-copilot": {
      "models": {
        "claude-opus-4.7": {
          "cost": {
            "input": 5,
            "output": 25
          }
        },
        "claude-sonnet-4.6": {
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "gpt-5.2-codex": {
          "cost": {
            "input": 1.75,
            "output": 14
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://ollamago.tforce.xyz/v1",
        "apiKey": "sk-bf-00000000"
      },
      "models": {
        "gemma-4:31b-instruct": {
          "id": "gemma-4:31b-instruct",
          "name": "Gemma 4 31B Instruct",
          "cost": {
            "input": 0.140,
            "output": 0.400
          },
          "limit": {
            "context": 98304,
            "output": 16384
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        },
        "qwen3.6:27b": {
          "id": "qwen3.6:27b",
          "name": "Qwen3.6 27B",
          "cost": {
            "input": 0.500,
            "output": 3.000
          },
          "limit": {
            "context": 196608,
            "output": 262144
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        }
      }
    }
  }
}
