{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Models",
  "description": "Schema for LLM model definitions",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
    "type": "object",
    "required": ["name", "home", "capabilities", "cost", "limit", "modalities", "deployments"],
    "properties": {
      "name": { "type": "string" },
      "base": { "type": "string" },
      "home": { "type": "string", "format": "uri" },
      "oss": { "type": "string", "format": "uri" },
      "specs": { "type": "string", "format": "uri" },
      "dev": { "type": "string", "format": "uri" },
      "cost": { "$ref": "#/definitions/cost" },
      "capabilities": { "$ref": "#/definitions/capabilities" },
      "limit": { "$ref": "#/definitions/limit" },
      "modalities": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "array", "items": { "type": "string", "enum": ["text", "pdf", "image", "video", "audio"] } },
          "output": { "type": "array", "items": { "type": "string", "enum": ["text", "pdf", "image", "video", "audio"] } }
        },
        "additionalProperties": false
      },
      "deployments": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "cost": { "$ref": "#/definitions/cost" },
            "limit": { "$ref": "#/definitions/limit" },
            "capabilities": { "$ref": "#/definitions/capabilities" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "definitions": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["attachment", "function_call", "reasoning", "response_format", "structured", "stt", "temperature", "tool_choice", "tools", "tts", "vision"]
      },
      "uniqueItems": true
    },
    "cost": {
      "type": "object",
      "description": "Costs in USD: input/output/cache_read/cache_write/vision_input/vision_output per 1M tokens; image_input/image_output per 1K images; pixel_input/pixel_output per megapixel.",
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cache_read": { "type": "number", "minimum": 0 },
        "cache_write": { "type": "number", "minimum": 0 },
        "vision_input": { "type": "number", "minimum": 0 },
        "vision_output": { "type": "number", "minimum": 0 },
        "image_input": { "type": "number", "minimum": 0 },
        "image_output": { "type": "number", "minimum": 0 },
        "pixel_input": { "type": "number", "minimum": 0 },
        "pixel_output": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "properties": {
        "context": { "type": "integer", "minimum": 1 },
        "output": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
