{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Models",
  "description": "Schema for LLM model definitions",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
    "type": "object",
    "required": ["name", "home", "capabilities", "cost", "limit", "modalities", "deployments"],
    "properties": {
      "name": { "type": "string" },
      "home": { "type": "string", "format": "uri" },
      "oss": { "type": "string", "format": "uri" },
      "dev": { "type": "string", "format": "uri" },
      "cost": { "$ref": "#/definitions/cost" },
      "capabilities": { "$ref": "#/definitions/capabilities" },
      "limit": { "$ref": "#/definitions/limit" },
      "modalities": {
        "type": "object",
        "required": ["input", "output"],
        "properties": {
          "input": { "type": "array", "items": { "type": "string", "enum": ["text", "image", "video", "audio"] } },
          "output": { "type": "array", "items": { "type": "string", "enum": ["text", "image", "video", "audio"] } }
        },
        "additionalProperties": false
      },
      "deployments": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "cost": { "$ref": "#/definitions/cost" },
            "limit": { "$ref": "#/definitions/limit" },
            "capabilities": { "$ref": "#/definitions/capabilities" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "definitions": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["function_call", "reasoning", "structured", "temperature", "tool_choice", "vision"]
      },
      "uniqueItems": true
    },
    "cost": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "limit": {
      "type": "object",
      "required": ["context", "output"],
      "properties": {
        "context": { "type": "integer", "minimum": 1 },
        "output": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
